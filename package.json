{
  "name": "midnight-restaurant",
  "private": true,
  "version": "0.4.0",
  "description": "まよなか屋 Midnight Restaurant: a cozy two-player online ramen stall for learning Japanese",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "lint": "prettier --check src && tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "three": "^0.170.0"
  }
}
