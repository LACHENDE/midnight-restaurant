{
  "name": "midnight-restaurant",
  "private": true,
  "version": "0.4.0",
  "description": "\u307e\u3088\u306a\u304b\u5c4b Midnight Restaurant: a cozy two-player online ramen stall for learning Japanese",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "lint": "prettier --check src && tsc --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "peerjs": "^1.5.4"
  }
}
